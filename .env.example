# ============================================================
# FlowlyRent — Variables d'environnement
# Copier ce fichier en .env et remplir toutes les valeurs
# NE JAMAIS committer le fichier .env dans git
# ============================================================

# Base de données (dev local)
DB_USERNAME=flowlyrent
DB_PASSWORD=flowlyrent
MYSQL_ROOT_PASSWORD=un_mot_de_passe_fort
MYSQL_DATABASE=flowlyrent

# JWT — clé secrète (base64, minimum 32 octets)
# Générer : openssl rand -base64 32
JWT_SECRET=votre_cle_secrete_base64_32_octets_minimum
JWT_EXPIRATION=604800000

# Administration (compte superadmin initial)
ADMIN_USERNAME=votre_email_admin
ADMIN_PASSWORD=votre_mot_de_passe_securise

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe — IDs des plans d'abonnement (créer dans Stripe Dashboard > Produits)
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_AGENCE=price_...

# Email (optionnel — laisser vide pour désactiver)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=votre@email.com
MAIL_PASSWORD=votre_app_password

# Nom affiché dans les emails
APP_NAME=FlowlyRent

# Analytics — emails exclus des KPIs (séparés par virgule)
ANALYTICS_INTERNAL_EMAILS=admin@votredomaine.com
